# ============================================================
# Tambahan env var khusus SIM Kosgoro, di luar .env default Laravel
# (APP_KEY dst tetap ikut yang di-generate `laravel new`)
# ============================================================

# --- Database (Supabase Postgres) ---
# Ambil dari Supabase: Project Settings -> Database -> Connection string -> URI (mode "Session")
DB_CONNECTION=pgsql
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=password-database-supabase
DB_SSLMODE=require

# --- Wajib false di production, jangan sampai lupa (lihat DEPLOY.md bagian Keamanan) ---
APP_DEBUG=false

# --- Frontend & Sanctum (WAJIB diisi domain asli waktu online) ---
FRONTEND_URL=https://sim-kosgoro.vercel.app
SANCTUM_STATEFUL_DOMAINS=sim-kosgoro.vercel.app

# --- Akun admin pertama (dipakai AdminUserSeeder) ---
# WAJIB diganti sebelum jalanin: php artisan db:seed --class=AdminUserSeeder
ADMIN_EMAIL=kosgoro-kosgoro@smk-kosgoro.sch.id
ADMIN_PASSWORD=Kosgoro-Kosgoro26!

# --- Sinkronisasi Excel kehadiran harian (opsional) ---
EXCEL_SYNC_PATH=/app/storage/app/presensi/presensi_harian.xlsx
EXCEL_KETIDAKHADIRAN_PATH=/app/storage/app/presensi/ketidakhadiran.xlsx
